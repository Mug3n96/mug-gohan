# App login key (any string)
API_KEY=change_me

# Backend
PORT=3000
NODE_ENV=production
DATA_DIR=/app/data

# Ollama — use a model that supports vision (recipe photos are sent as images).
# Local or cloud (…-cloud) model is your choice.
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b
# OLLAMA_API_KEY=          # only for the direct ollama.com API (OLLAMA_HOST=https://ollama.com)

# Whisper — optional voice input. Whisper transcribes audio to text on its own;
# the LLM never receives audio. Set the URL to show the mic button.
# WHISPER_URL=http://whisper:9000
