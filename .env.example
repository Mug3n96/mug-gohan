# Login code for the app (any string)
API_KEY=change_me

# Ollama. The model must support vision (recipe photos are sent as images).
#   Local:  OLLAMA_MODEL=gemma4:e2b         (free, needs RAM, slow without GPU)
#   Cloud:  OLLAMA_MODEL=gemma4:31b-cloud   (pay per token, run `ollama signin` once)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma4:e2b

# Cloud without the Ollama container: talk to ollama.com directly.
# OLLAMA_HOST=https://ollama.com
# OLLAMA_API_KEY=            # from ollama.com/settings/keys

# Optional voice input via Whisper (shows the mic button when set)
# WHISPER_URL=http://whisper:9000
